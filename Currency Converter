import json
import os
from datetime import datetime
import urllib.request
import urllib.error

# ========== Конфигурация ==========
HISTORY_FILE = "history.json"

# ВАЖНО: Замените YOUR_API_KEY на свой реальный ключ от exchangerate-api.com
# Получить ключ можно бесплатно на https://app.exchangerate-api.com/sign-up
API_KEY = "YOUR_API_KEY"  # Замените на ваш API ключ
API_URL = f"https://v6.exchangerate-api.com/v6/{API_KEY}/latest/"

# Список популярных валют
CURRENCIES = [
    "USD", "EUR", "RUB", "GBP", "CNY", "JPY", "CAD", "CHF", 
    "AUD", "INR", "BRL", "TRY", "KRW", "AED", "UAH", "KZT"
]

# ========== Работа с API ==========
def get_exchange_rate(from_currency, to_currency):
    """Получает курс обмена через внешнее API"""
    try:
        url = API_URL + from_currency
        with urllib.request.urlopen(url) as response:
            data = json.loads(response.read().decode('utf-8'))
            
            if data.get("result") == "success":
                rates = data.get("conversion_rates", {})
                if to_currency in rates:
                    return rates[to_currency]
                else:
                    messagebox.showerror("Ошибка", f"Валюта {to_currency} не найдена!")
                    return None
            else:
                messagebox.showerror("Ошибка", "Не удалось получить курсы валют!")
                return None
                
    except urllib.error.URLError:
        messagebox.showerror("Ошибка", "Нет подключения к интернету!")
        return None
    except Exception as e:
        messagebox.showerror("Ошибка", f"Ошибка при получении курса: {e}")
        return None

def convert_currency():
    """Конвертирует сумму из одной валюты в другую"""
    try:
        # Получаем данные
        amount = amount_entry.get().strip()
        from_curr = from_currency_var.get()
        to_curr = to_currency_var.get()
        
        # Валидация
        if not amount:
            messagebox.showwarning("Предупреждение", "Введите сумму для конвертации!")
            return
        
        amount_float = float(amount)
        if amount_float <= 0:
            messagebox.showwarning("Предупреждение", "Сумма должна быть положительным числом!")
            return
        
        if from_curr == to_curr:
            result = amount_float
            rate = 1.0
        else:
            # Получаем курс
            rate = get_exchange_rate(from_curr, to_curr)
            if rate is None:
                return
            result = amount_float * rate
        
        # Отображаем результат
        result_label.config(
            text=f"{amount_float:.2f} {from_curr} = {result:.2f} {to_curr}",
            fg="#4CAF50"
        )
        
        # Показываем курс
        rate_label.config(text=f"Курс: 1 {from_curr} = {rate:.4f} {to_curr}")
        
        # Сохраняем в историю
        add_to_history(amount_float, from_curr, to_curr, result, rate)
        
        # Очищаем поле ввода
        amount_entry.delete(0, tk.END)
        
    except ValueError:
        messagebox.showerror("Ошибка", "Введите корректное число!")

def add_to_history(amount, from_curr, to_curr, result, rate):
    """Добавляет конвертацию в историю"""
    history = load_history()
    
    entry = {
        "date": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "amount": amount,
        "from_currency": from_curr,
        "to_currency": to_curr,
        "result": result,
        "rate": rate
    }
    
    history.append(entry)
    save_history(history)
    update_history_table(history)

def load_history():
    """Загружает историю из JSON файла"""
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as file:
                return json.load(file)
        except (json.JSONDecodeError, IOError):
            return []
    return []

def save_history(history):
    """Сохраняет историю в JSON файл"""
    try:
        with open(HISTORY_FILE, "w", encoding="utf-8") as file:
            json.dump(history, file, ensure_ascii=False, indent=4)
    except IOError:
        messagebox.showerror("Ошибка", "Не удалось сохранить историю!")

def update_history_table(history):
    """Обновляет таблицу истории"""
    # Очищаем таблицу
    for row in history_table.get_children():
        history_table.delete(row)
    
    # Добавляем записи (показываем последние 10 в обратном порядке)
    for entry in reversed(history[-10:]):
        history_table.insert("", "end", values=(
            entry["date"],
            f"{entry['amount']:.2f}",
            entry["from_currency"],
            entry["to_currency"],
            f"{entry['result']:.2f}",
            f"{entry['rate']:.4f}"
        ))

def clear_history():
    """Очищает историю конвертаций"""
    if messagebox.askyesno("Подтверждение", "Вы уверены, что хотите очистить всю историю?"):
        save_history([])
        update_history_table([])
        messagebox.showinfo("Успех", "История очищена!")

def swap_currencies():
    """Меняет местами валюты 'из' и 'в'"""
    from_curr = from_currency_var.get()
    to_curr = to_currency_var.get()
    from_currency_var.set(to_curr)
    to_currency_var.set(from_curr)

def set_favorite_rate():
    """Устанавливает курс из истории для быстрой конвертации"""
    selected = history_table.selection()
    if not selected:
        messagebox.showwarning("Предупреждение", "Выберите запись в истории!")
        return
    
    # Получаем выбранную запись
    item_values = history_table.item(selected[0], "values")
    from_currency_var.set(item_values[2])
    to_currency_var.set(item_values[3])
    
    # Вставляем сумму в поле ввода
    amount_entry.delete(0, tk.END)
    amount_entry.insert(0, item_values[1])
    
    messagebox.showinfo("Успех", "Данные из истории загружены!")

# ========== Проверка API ключа ==========
def check_api_key():
    """Проверяет, что API ключ был заменён"""
    if API_KEY == "YOUR_API_KEY":
        messagebox.showwarning(
            "Внимание!",
            "Пожалуйста, получите бесплатный API ключ на https://app.exchangerate-api.com/sign-up\n"
            "и замените YOUR_API_KEY в коде программы!"
        )
        return False
    return True

